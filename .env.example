# Copy to `.env` to override. Unset = live host.
# Must start with PUBLIC_ so Astro exposes it to browser scripts (login/submit).
# Same-origin note: in `astro dev` the browser calls same-origin `/api` and the
# dev server proxies it to this base (astro.config.mjs), so localhost needs no
# CORS. The static build calls this base directly - the deployed origin must
# stay in the API's CORS allowlist.
PUBLIC_SWEG_API_BASE=https://api.ai-sweg.my.id

# Sign in with swegrowth.id: that site's Supabase project URL and publishable
# key (public; the same two values swegrowth.id ships to every browser).
# Both unset = the button is hidden. Add https://<this host>/login/swegrowth
# to the project's Auth > URL Configuration > Redirect URLs.
PUBLIC_SWEGROWTH_SUPABASE_URL=
PUBLIC_SWEGROWTH_SUPABASE_KEY=
