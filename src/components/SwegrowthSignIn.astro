---
/** "Continue with swegrowth.id" for /login and /register. Renders nothing
 *  when the build has no swegrowth.id project configured. */
import { swegrowthEnabled } from '../lib/swegrowth';
---
{swegrowthEnabled && (
  <div class="sso">
    <button type="button" class="button-primary" id="swegrowth-start">continue with swegrowth.id</button>
    <p class="small muted">the same Google account you use on swegrowth.id. first time here? an account is made for you.</p>
    <p class="small err" id="swegrowth-status" hidden></p>
    <p class="sso-or small muted">or</p>
  </div>
)}

<script>
  import { SwegrowthError, startSwegrowthSignIn, stripResumeMarker } from '../lib/swegrowth';
  import { safeNext } from '../lib/nav';

  const startBtn = document.getElementById('swegrowth-start') as HTMLButtonElement | null;
  const status = document.getElementById('swegrowth-status') as HTMLParagraphElement | null;

  const params = new URLSearchParams(location.search);
  const next = safeNext(params.get('next'));
  let started = false;

  async function start() {
    if (started || !startBtn) return;
    started = true;
    startBtn.disabled = true;
    try {
      await startSwegrowthSignIn(next);
    } catch (error) {
      started = false;
      startBtn.disabled = false;
      if (status) {
        status.textContent =
          error instanceof SwegrowthError
            ? error.message
            : 'could not start the sign-in from this browser.';
        status.hidden = false;
      }
    }
  }

  startBtn?.addEventListener('click', () => {
    void start();
  });

  if (params.get('sso') === '1') {
    stripResumeMarker();
    void start();
  }
</script>
