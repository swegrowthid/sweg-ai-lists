---
import { NAV, SITE } from "../data/site";
import '../styles/style.css';
import logoUrl from '../assets/logo.jpeg';

interface Props {
  title?: string;
  description?: string;
  /** Tagline under the hairline rule, home page only. */
  tagline?: string;
  /** Breadcrumb segment after "home", e.g. the category name on /s/<slug>. */
  crumb?: string;
}

const { title, description, tagline, crumb } = Astro.props;
const pageTitle = title ? `${title} - ${SITE.name}` : SITE.title;
const mastheadLabel = crumb ?? title;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description ?? SITE.description} />
    <meta name="theme-color" content="#f4f6f1" id="theme-color" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script is:inline>
      try {
        var t = localStorage.getItem('sweg-ai-theme');
        if (!t) t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = t;
      } catch (e) {
        document.documentElement.dataset.theme = 'light';
      }
    </script>
  </head>
  <body>
    <header class="site-header">
      <div id="masthead">
        <a class="brand" href="/" aria-label={`${SITE.name} home`}>
          <img src={logoUrl.src ?? logoUrl} alt="" width="40" height="38" />
        </a>
        {mastheadLabel ? <span class="bc">{mastheadLabel}</span> : null}
        <div class="masthead-actions">
          <a class="login-link" href="/login" data-auth="out" hidden>Log in</a>
          <a class="login-link" href="/profile" data-auth="in" hidden>Profile</a>
          <button class="logout-link" id="header-logout" type="button" data-auth="in" hidden>Log out</button>
          <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Switch to dark mode" title="Switch to dark mode">☾</button>
        </div>
      </div>
      <nav id="topnav" aria-label="Main navigation">
      {
        NAV.map((item) => (
          <a
            href={item.href}
            class:list={[item.badge && 'badge', item.label === 'post an entry' && 'nav-cta']}
            data-auth={item.auth}
            hidden={!!item.auth}
          >
            {item.label}
          </a>
        ))
      }
      </nav>
    </header>
    <main id="main-content">
      {tagline ? <p class="tagline">{tagline}</p> : null}
      <slot />
    </main>
    <footer class="site-footer">
      <a href="/about">about</a>
      <a href="/help">help</a>
      <a href="/submit" data-auth="in" hidden>submit</a>
      <a href="/wanted">wanted</a>
      <span> · <a href="https://swegrowth.id/">swegrowth.id</a></span>
    </footer>
    <script is:inline>
      (function () {
        var btn = document.getElementById('theme-toggle');
        var meta = document.getElementById('theme-color');
        function paint(t) {
          document.documentElement.dataset.theme = t;
          if (btn) {
            btn.textContent = t === 'dark' ? '☀︎' : '☾';
            btn.setAttribute('aria-label', t === 'dark' ? 'Switch to light mode' : 'Switch to dark mode');
            btn.setAttribute('title', t === 'dark' ? 'Switch to light mode' : 'Switch to dark mode');
          }
          if (meta) meta.setAttribute('content', t === 'dark' ? '#111d20' : '#f4f6f1');
        }
        try {
          paint(document.documentElement.dataset.theme || 'light');
        } catch (e) {}
        if (btn)
          btn.addEventListener('click', function () {
            var next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
            try {
              localStorage.setItem('sweg-ai-theme', next);
            } catch (e) {}
            paint(next);
          });
        // Auth gate: static build cannot know login state, so gated links
        // start hidden and reveal only when localStorage holds a token.
        var loggedIn = false;
        try {
          var raw = localStorage.getItem('sweg-ai-tokens');
          loggedIn = !!(raw && JSON.parse(raw).access_token);
        } catch (e) {}
        for (const el of document.querySelectorAll('[data-auth]')) {
          const need = el.getAttribute('data-auth');
          if (need === 'in' ? loggedIn : !loggedIn) el.removeAttribute('hidden');
        }
      })();
    </script>
    <script>
      import { logoutSession } from '../lib/session';

      document.getElementById('header-logout')?.addEventListener('click', () => {
        logoutSession();
        location.href = '/login';
      });
    </script>
  </body>
</html>
