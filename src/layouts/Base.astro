---
import { NAV, SITE } from "../data/site";
import '../styles/style.css';

interface Props {
  title?: string;
  description?: string;
  /** Tagline under the hairline rule, home page only. */
  tagline?: string;
  /** Breadcrumb segment after "home", e.g. the category name on /s/<slug>. */
  crumb?: string;
}

const { title, description, tagline, crumb } = Astro.props;
const pageTitle = title ? `${title} - ${SITE.name}` : SITE.title;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description ?? SITE.description} />
    <meta name="theme-color" content="#551a8b" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
  </head>
  <body>
    <div id="masthead">
      <a class="logo" href="/">{SITE.name}</a>
      <span class="bc"><a href="/">home</a>{
        crumb ? <Fragment> {crumb}</Fragment> : null
      }</span>
    </div>
    <div id="topnav">
      {
        NAV.map((item) => (
          <a href={item.href} class={item.badge ? 'badge' : undefined}>
            {item.label}
          </a>
        ))
      }
    </div>
    <hr />
    {tagline ? <p class="tagline">{tagline}</p> : null}
    <slot />
    <footer>
      <a href="/about">about</a>
      <a href="/help">help</a>
      <a href="/submit">submit</a>
      <a href="/wanted">wanted</a>
      <span> · © {SITE.name} {SITE.room}</span>
    </footer>
  </body>
</html>
