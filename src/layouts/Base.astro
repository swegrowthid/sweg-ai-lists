---
import { NAV, SITE } from "../data/site";
import '../styles/style.css';

interface Props {
  title?: string;
  description?: string;
  /** Tagline under the hairline rule, home page only. */
  tagline?: string;
  /** Breadcrumb segment after "home", e.g. the category name on /s/<slug>. */
  crumb?: string;
}

const { title, description, tagline, crumb } = Astro.props;
const pageTitle = title ? `${title} - ${SITE.name}` : SITE.title;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description ?? SITE.description} />
    <meta name="theme-color" content="#551a8b" id="theme-color" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <script is:inline>
      try {
        var t = localStorage.getItem('sweg-ai-theme');
        if (!t) t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = t;
      } catch (e) {
        document.documentElement.dataset.theme = 'light';
      }
    </script>
  </head>
  <body>
    <div id="masthead">
      <a class="logo" href="/" aria-label={SITE.name}><img src="/logo.jpeg" alt={SITE.name} width="120" height="113" /></a>
      <span class="bc"><a href="/">home</a>{
        crumb ? <Fragment> {crumb}</Fragment> : null
      }</span>
      <button id="theme-toggle" class="linkbutton" type="button">dark</button>
    </div>
    <div id="topnav">
      {
        NAV.map((item) => (
          <a href={item.href} class={item.badge ? 'badge' : undefined}>
            {item.label}
          </a>
        ))
      }
    </div>
    <hr />
    {tagline ? <p class="tagline">{tagline}</p> : null}
    <slot />
    <footer>
      <a href="/about">about</a>
      <a href="/help">help</a>
      <a href="/submit">submit</a>
      <a href="/wanted">wanted</a>
      <span> · © {SITE.name} {SITE.room}</span>
    </footer>
    <script is:inline>
      (function () {
        var btn = document.getElementById('theme-toggle');
        var meta = document.getElementById('theme-color');
        function paint(t) {
          document.documentElement.dataset.theme = t;
          if (btn) btn.textContent = t === 'dark' ? 'light' : 'dark';
          if (meta) meta.setAttribute('content', t === 'dark' ? '#1a1a1a' : '#551a8b');
        }
        try {
          paint(document.documentElement.dataset.theme || 'light');
        } catch (e) {}
        if (btn)
          btn.addEventListener('click', function () {
            var next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
            try {
              localStorage.setItem('sweg-ai-theme', next);
            } catch (e) {}
            paint(next);
          });
      })();
    </script>
  </body>
</html>
