---
import Base from '../layouts/Base.astro';
---
<Base title="post an entry">
  <header class="page-head">
    <p class="eyebrow">contribute to the catalog</p>
    <h1>Post an entry</h1>
    <p class="lede">Share a useful AI workflow with the community.</p>
  </header>
  <p>
    Posts go straight to the live API and open right away. An API account
    is created once at <a href="/register">register</a>, then <a href="/login">log in</a>.
  </p>
  <form class="form" id="post-form">
    <div class="row">
      <label for="title">title</label>
      <input type="text" id="title" name="title" maxlength="200" required />
      <p class="small">the slug is generated from this - <code>my first post</code> becomes <code>my-first-post</code>.</p>
    </div>
    <div class="row">
      <label for="category">category</label>
      <input type="text" id="category" name="category" list="category-list" maxlength="100" required />
      <datalist id="category-list"></datalist>
      <p class="small" id="category-hint">any slug - top-level like <code>coding</code> or a derivative like <code>claude-code</code>.</p>
    </div>
    <div class="row">
      <label for="kind">item kind</label>
      <select id="kind" name="kind">
        <option value="markdown">markdown</option>
        <option value="text">text</option>
        <option value="link">link</option>
        <option value="file">file</option>
      </select>
      <p class="small">This form posts one item; a post can hold up to 20 through the API.</p>
    </div>
    <div class="row" id="body-row">
      <label for="body" id="body-label">body</label>
      <textarea id="body" name="body" rows="10"></textarea>
    </div>
    <div class="row" id="url-row" hidden>
      <label for="url">url</label>
      <input type="url" id="url" name="url" placeholder="https://github.com/you/repo" />
      <p class="small">full link starting with <code>https://</code> - bare domains are rejected.</p>
    </div>
    <div class="row" id="filename-row" hidden>
      <label for="filename">filename</label>
      <input type="text" id="filename" name="filename" placeholder="SKILL.md" />
    </div>
    <div class="row" id="mime-row" hidden>
      <label for="mime">mime</label>
      <input type="text" id="mime" name="mime" value="text/markdown" />
    </div>
    <div class="actions">
      <button type="submit">post</button>
    </div>
  </form>
  <p class="small" id="status" hidden></p>
  <p class="small" id="auth"></p>

  <script>
    import { ApiError, createPost, fetchCategories } from '../lib/api';
    import type { CreatePostInput, ItemKind } from '../lib/api';
    import { ensurePair, handleExpiredSession, isTokenExpired, storedPair } from '../lib/session';

    // Element lookups are typed here; the markup above owns these ids.
    function byId<T extends HTMLElement>(id: string): T {
      return document.getElementById(id) as T;
    }

    const form = byId<HTMLFormElement>('post-form');
    const status = byId<HTMLParagraphElement>('status');
    const auth = byId<HTMLParagraphElement>('auth');
    const kind = byId<HTMLSelectElement>('kind');

    function renderAuth() {
      auth.innerHTML = storedPair()?.access_token
        ? 'posting as the logged-in account · <a href="/login">switch account</a>'
        : 'not logged in — <a href="/login">log in</a> to post through the API, or use the PR route below.';
    }

    function syncKind() {
      const value = kind.value as ItemKind;
      byId<HTMLDivElement>('body-row').hidden = value === 'link';
      byId<HTMLDivElement>('url-row').hidden = value !== 'link';
      byId<HTMLDivElement>('filename-row').hidden = value !== 'file';
      byId<HTMLDivElement>('mime-row').hidden = value !== 'file';
      byId<HTMLLabelElement>('body-label').textContent = value === 'file' ? 'file contents' : 'body';
      // The API rejects an empty field that the kind owns - required moves
      // that check from the server response to the field itself.
      byId<HTMLInputElement>('url').required = value === 'link';
      byId<HTMLTextAreaElement>('body').required = value !== 'link';
      byId<HTMLInputElement>('filename').required = value === 'file';
    }

    // Only the fields that belong to the chosen kind are sent; the API rejects extras.
    function payload(): CreatePostInput {
      const kindValue = kind.value as ItemKind;
      const item: CreatePostInput['items'][number] = { kind: kindValue };
      if (kindValue === 'link') {
        // The API requires an absolute http(s) URL; forgive a bare domain.
        let link = byId<HTMLInputElement>('url').value.trim();
        if (link && !/^https?:\/\//i.test(link)) link = `https://${link}`;
        item.url = link;
      } else {
        item.body_text = byId<HTMLTextAreaElement>('body').value;
        if (kindValue === 'file') {
          item.filename = byId<HTMLInputElement>('filename').value.trim();
          const mime = byId<HTMLInputElement>('mime').value.trim();
          if (mime) item.mime = mime;
        }
      }
      return {
        title: byId<HTMLInputElement>('title').value.trim(),
        category: byId<HTMLInputElement>('category').value.trim(),
        items: [item],
      };
    }

    // Category slugs come from the API; the datalist keeps the input usable
    // when the fetch cannot run (offline, or a CORS-blocked cross-origin deploy).
    async function loadCategories() {
      const hint = byId<HTMLParagraphElement>('category-hint');
      try {
        const categories = await fetchCategories();
        const list = byId<HTMLDataListElement>('category-list');
        // One field accepts every slug - parents and derivatives alike; the
        // API resolves a derivative to its parent on its own.
        list.replaceChildren(...categories.map((c) => new Option(c.slug, c.slug)));
        hint.textContent = `${categories.length} slugs loaded - parents and derivatives accepted.`;
      } catch {
        hint.textContent = 'could not load category slugs from the API - type one that exists.';
      }
    }

    function setStatus(text: string, cls: string) {
      status.className = cls;
      status.textContent = text;
      status.hidden = false;
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const hadTokens = !!storedPair();
      const token = (await ensurePair())?.access_token;
      if (!token) {
        // Tokens existed but died (refresh rejected) -> must log in again.
        if (hadTokens) {
          handleExpiredSession();
          return;
        }
        setStatus('not logged in — log in first.', 'small err');
        return;
      }
      setStatus('posting…', 'small');
      try {
        const post = await createPost(payload(), token);
        // The generated slug answers immediately - detail pages render live.
        location.href = `/entry/?s=${encodeURIComponent(post.slug)}`;
        return;
      } catch (error) {
        // A dead token must log in again; the redirect clears the pair.
        if (isTokenExpired(error)) {
          handleExpiredSession();
          return;
        }
        // ApiError carries the API's text/plain reason; anything else means the request
        // never landed (offline, or the API's CORS policy blocking this origin).
        setStatus(
          error instanceof ApiError
            ? error.message
            : 'could not reach the API from this page — use the PR route below.',
          'small err',
        );
      }
    });

    kind.addEventListener('change', syncKind);
    syncKind();
    renderAuth();
    void loadCategories();
  </script>
</Base>
