---
import Base from '../layouts/Base.astro';
import ToolsCatalog from '../components/ToolsCatalog';
import { fetchTools } from '../lib/api';
import type { ApiTool } from '../lib/api';

/** Rows per request. The API rejects a `per_page` above 100. */
const PAGE_SIZE = 50;

/** The build renders the first rows so the static page has content before
 *  hydration. The island then loads the full catalog and filters it in the
 *  browser - the URL stays the query state, so shared links keep working. */
let tools: ApiTool[] = [];
try {
  tools = (await fetchTools({ perPage: PAGE_SIZE })).data;
} catch {
  // The API is unreachable at build time. Render the shell; the island retries.
}
---

<Base title="ai tools" crumb="ai tools">
  <header class="page-head">
    <p class="eyebrow">ai tools catalog</p>
    <h1>AI Tools</h1>
    <p class="lede">
      Providers, coding agents, and dev environments tracked by the community - synced daily from <a href="https://github.com/swegrowthid/tools-ai-swe-growth">tools-ai-swe-growth</a>.
    </p>
  </header>

  <ToolsCatalog tools={tools} client:load />
</Base>
