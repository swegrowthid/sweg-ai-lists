---
import Base from '../layouts/Base.astro';
import ToolsList from '../components/ToolsList';
import { fetchTools } from '../lib/api';
import type { ApiPageMeta, ApiTool } from '../lib/api';

/** Rows per request. Matches the island's PAGE_SIZE and stays under the API
 *  cap of 100. The island fetches every later page at runtime. */
const PAGE_SIZE = 50;

/** The build renders page 1 - rows, count line, and pager - so the static page
 *  has content and working links before hydration. The URL stays the query
 *  state, so shared links keep working. */
let tools: ApiTool[] = [];
let meta: ApiPageMeta | null = null;
let buildFailed = false;
try {
  const page = await fetchTools({ page: 1, perPage: PAGE_SIZE });
  tools = page.data;
  meta = page.meta;
} catch {
  // The API is unreachable at build time. Render the shell with a visible
  // notice; the island retries at runtime.
  buildFailed = true;
}
---

<Base title="AI Tools">
  <header class="page-head">
    <p class="eyebrow">discover AI tools</p>
    <h1>AI Tools</h1>
    <p class="lede">
      Browse providers, coding agents, and dev environments. Synced daily from the <a href="https://github.com/swegrowthid/tools-ai-swe-growth">swegrowthid/tools-ai-swe-growth repo</a>.
    </p>
  </header>

  <ToolsList tools={tools} meta={meta} buildFailed={buildFailed} client:load />
</Base>
