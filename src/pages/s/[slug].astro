---
import Base from "../../layouts/Base.astro";
import EntryRows from "../../components/EntryRows.astro";
import { fetchCategories, fetchPosts, postToRow } from "../../lib/api";
import type { ApiCategory, ApiPost } from "../../lib/api";

export async function getStaticPaths() {
  let cats: ApiCategory[] = [];
  try {
    cats = await fetchCategories();
  } catch {
    cats = [];
  }
  return cats.map((c) => ({ params: { slug: c.slug }, props: { name: c.name } }));
}
const { slug } = Astro.params;
const { name } = Astro.props;

let apiPosts: ApiPost[] = [];
try {
  // The API filters server-side (?category=); an unknown slug or a dead API
  // yields [], and the page renders an empty state.
  apiPosts = await fetchPosts({ category: slug });
} catch {
  apiPosts = [];
}

// The API already filtered by `slug`; sorting uses created_at, the field
// postToRow renders the date from.
const rows = apiPosts
  .map((post) => ({ ts: Date.parse(post.created_at) || 0, row: postToRow(post) }))
  .sort((a, b) => b.ts - a.ts)
  .map((item) => item.row);
---

<Base title={name} crumb={name}>
  <header class="page-head">
    <p class="eyebrow">browse category</p>
    <h1>{name}</h1>
    <p class="lede">Community-shared posts in this category.</p>
  </header>
  {
    rows.length > 0 ? (
      <EntryRows rows={rows} />
    ) : (
      <p class="empty-state">No posts yet in this category.</p>
    )
  }
</Base>
