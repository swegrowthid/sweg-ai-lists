---
import Base from "../../layouts/Base.astro";
import EntryRows from "../../components/EntryRows.astro";
import { fetchCategories, fetchPosts, postToRow } from "../../lib/api";
import type { ApiCategory, ApiPost } from "../../lib/api";

export async function getStaticPaths() {
  let cats: ApiCategory[] = [];
  try {
    cats = await fetchCategories();
  } catch {
    cats = [];
  }
  return cats.map((c) => ({ params: { slug: c.slug }, props: { name: c.name } }));
}
const { slug } = Astro.params;
const { name } = Astro.props;

let apiPosts: ApiPost[] = [];
try {
  // The API filters server-side (?category=); an unknown slug or a dead API
  // yields [], and the page renders an empty state.
  apiPosts = await fetchPosts({ category: slug });
} catch {
  apiPosts = [];
}

// The API already filtered by `slug`; sorting uses created_at, the field
// postToRow renders the date from.
const rows = apiPosts
  .map((post) => ({ ts: Date.parse(post.created_at) || 0, row: postToRow(post) }))
  .sort((a, b) => b.ts - a.ts)
  .map((item) => item.row);
---

<Base title={name}>
  <header class="page-head">
    <p class="eyebrow">browse category</p>
    <h1>{name}</h1>
    <p class="lede">Community-shared posts in this category.</p>
  </header>
  <div id="post-rows" data-slug={slug}>
    <EntryRows rows={rows} />
  </div>
  <p class="empty-state" id="posts-empty" hidden={rows.length > 0}>No posts yet in this category.</p>

  <script>
    import { fetchPosts } from '../../lib/api';
    import { postRowsHtml } from '../../lib/posts';

    // The list is baked at build time; refresh it once so posts created since
    // the last deploy appear without a rebuild. Failure keeps the snapshot.
    async function refreshPosts() {
      const slug = document.getElementById('post-rows')?.getAttribute('data-slug') ?? '';
      if (!slug) return;
      let posts;
      try {
        posts = await fetchPosts({ category: slug });
      } catch {
        return;
      }
      const tbody = document.querySelector<HTMLTableSectionElement>('#post-rows .rows tbody');
      if (!tbody) return;
      posts.sort((a, b) => (Date.parse(b.created_at) || 0) - (Date.parse(a.created_at) || 0));
      tbody.innerHTML = postRowsHtml(posts);
      const empty = document.getElementById('posts-empty');
      if (empty) empty.hidden = posts.length > 0;
    }

    void refreshPosts();
  </script>
</Base>
