---
import { getCollection } from 'astro:content';
import Base from "../../layouts/Base.astro";
import EntryRows from "../../components/EntryRows.astro";
import { CATEGORIES } from "../../data/site";
import { fetchCategories, fetchPosts, postToRow } from "../../lib/api";
import type { ApiPost } from "../../lib/api";

export async function getStaticPaths() {
  const cats: { slug: string; name: string }[] = CATEGORIES.map((c) => ({ slug: c.slug, name: c.name }));
  try {
    for (const cat of await fetchCategories()) {
      if (!cats.some((c) => c.slug === cat.slug)) cats.push({ slug: cat.slug, name: cat.name });
    }
  } catch {
    // API empty or unreachable: the static categories still describe the site.
  }
  return cats.map((c) => ({ params: { slug: c.slug }, props: { name: c.name } }));
}

const { slug } = Astro.params;
const { name } = Astro.props;

let apiPosts: ApiPost[] = [];
try {
  // The API filters server-side (?category=); an unknown slug or a dead API
  // yields [], and the local collection below still renders.
  apiPosts = await fetchPosts({ category: slug });
} catch {
  apiPosts = [];
}

const entries = (await getCollection('entries')).filter(
  (entry) => entry.data.status === 'approved' && entry.data.category === slug,
);
const localSlugs = new Set(entries.map((entry) => entry.id));

const rows = [
  ...entries.map((entry) => ({
    ts: entry.data.updated.getTime(),
    row: {
      url: `/entry/${entry.id}`,
      title: entry.data.title,
      summary: entry.data.summary,
      category: entry.data.category,
      author: entry.data.author,
      display: entry.data.kind === 'setting' ? 'setting' : 'free',
      date: entry.data.updated.toLocaleDateString('en-US', { month: 'short', day: 'numeric' }),
      attrs: {
        'data-source': 'local',
        'data-ts': String(entry.data.updated.getTime()),
        'data-kind': entry.data.kind,
        'data-category': entry.data.category,
        'data-text': `${entry.data.title} ${entry.data.summary} ${entry.data.tags.join(' ')}`.toLowerCase(),
      },
    },
  })),
  // The API already filtered by `slug`; sorting uses created_at, the field
  // postToRow renders the date from.
  ...apiPosts.filter((post) => !localSlugs.has(post.slug)).map((post) => ({ ts: Date.parse(post.created_at) || 0, row: postToRow(post) })),
]
  .sort((a, b) => b.ts - a.ts)
  .map((item) => item.row);
---

<Base title={name} crumb={name}>
  <header class="page-head">
    <p class="eyebrow">browse category</p>
    <h1>{name}</h1>
    <p class="lede">Community-shared skills and settings in this category.</p>
  </header>
  {
    rows.length > 0 ? (
      <EntryRows rows={rows} />
    ) : (
      <p class="empty-state">No entries yet in this category.</p>
    )
  }
</Base>
