---
import Base from '../layouts/Base.astro';
import { fetchWanted, postToRow } from '../lib/api';
import type { ApiPost } from '../lib/api';
import { CATEGORY_NAME } from '../data/site';
let wanted: ApiPost[] = [];
try {
  wanted = await fetchWanted();
} catch {
  wanted = [];
}
const rows = wanted.map((post) => ({
  ...postToRow(post),
  url: `/entry/${encodeURIComponent(post.slug)}`,
}));
---
<Base title="Wanted">
  <header class="page-head">
    <p class="eyebrow">community requests</p>
    <h1>Wanted</h1>
    <p class="lede">Ideas the community would love to see built. Pick one and share your version.</p>
  </header>
  <table class="wanted-table">
    <tbody>
      {rows.map((row) => (
        <tr>
          <td class="d">{row.date}</td>
          <td>
            <a href={row.url}>{row.title}</a> <span class="badge">wanted</span>
          </td>
          <td class="c"><a href={`/s/${row.category}`}>{CATEGORY_NAME[row.category] ?? row.category}</a></td>
          <td class="c">{row.author}</td>
        </tr>
      ))}
    </tbody>
  </table>
  <p class="empty-state" hidden={rows.length > 0}>No wanted skills yet. Check back soon.</p>
  <p>Wanted entries are existing skills the community has flagged as ideas worth building.</p>
</Base>
