---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ExampleCompare from '../../components/ExampleCompare.astro';
import { CATEGORY_NAME } from '../../data/site';
import { fetchPosts } from '../../lib/api';

interface LocalProps {
  source: 'local';
  entry: CollectionEntry<'entries'>;
}

interface ApiProps {
  source: 'api';
  slug: string;
}

export async function getStaticPaths() {
  const entries = await getCollection('entries');
  const paths: { params: { slug: string }; props: LocalProps | ApiProps }[] = entries.map((entry) => ({
    params: { slug: entry.id },
    props: { source: 'local', entry },
  }));

  // API posts add their slugs; a local entry claiming the same slug wins.
  const seen = new Set(paths.map((p) => p.params.slug));
  try {
    for (const post of await fetchPosts()) {
      if (seen.has(post.slug)) continue;
      seen.add(post.slug);
      paths.push({ params: { slug: post.slug }, props: { source: 'api', slug: post.slug } });
    }
  } catch {
    // API empty or unreachable: the local collection alone still builds the route.
  }

  return paths;
}

const props = Astro.props as LocalProps | ApiProps;

const local = props.source === 'local' ? props.entry : null;
const rendered = local ? await render(local) : null;
const Content = rendered ? rendered.Content : null;
const data = local?.data ?? null;
const catName = data ? (CATEGORY_NAME[data.category] ?? data.category) : '';
const dateStr = data
  ? data.updated.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })
  : '';

// API posts render client-side (see entry/index.astro + lib/postDetail.ts):
// the shell ships at build time, the post body hydrates in the browser, so
// the page always shows live data and can offer the owner a delete action.
---
<Base title={data ? data.title : 'post'} crumb={data ? catName : 'post'}>
  {data && Content ? (
    <div class="posting">
      <h1>{data.title}</h1>
      <div class="attrs">
        <span class={`kind kind-${data.kind}`}>{data.kind}</span>
        <span class={`st st-${data.status}`}>{data.status}</span>
        <span>
          <a href={`/s/${data.category}`}>{catName}</a>
        </span>
        {data.tags.map((tag) => (
          <span>{tag}</span>
        ))}
      </div>
      <p class="small">
        by {data.author} · updated {dateStr} · in{' '}
        <a href={`/s/${data.category}`}>{catName}</a>
      </p>
      {data.kind === 'skill' && data.install && (
        <p>
          install: <code>{data.install}</code>
        </p>
      )}
      {data.kind === 'setting' && (data.target || data.model) && (
        <p>
          {[data.target, data.model].filter(Boolean).join(' · ')}
        </p>
      )}
      <div class="body">
        <Content />
      </div>
      {data.examples.length > 0 && (
        <h2>examples</h2>
      )}
      <ExampleCompare examples={data.examples} />
    </div>
  ) : (
    <div class="posting" id="detail" data-slug={props.source === 'api' ? props.slug : ''}>
      <p class="muted">loading post…</p>
    </div>
  )}
  <script>
    import { mountPostDetail } from '../../lib/postDetail';

    const root = document.getElementById('detail') as HTMLElement | null;
    if (root?.dataset.slug) void mountPostDetail(root, root.dataset.slug);
  </script>
</Base>
