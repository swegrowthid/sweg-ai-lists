---
import Base from '../layouts/Base.astro';
---
<Base title="login">
  <h2>login</h2>
  <p>
    Accounts live in the API: <a href="/register">register</a> once, then log in
    here. The token stays in this browser and is what <a href="/submit">submit</a> posts with.
  </p>
  <form class="form" id="login-form">
    <div class="row">
      <label for="identifier">username or email</label>
      <input type="text" id="identifier" name="identifier" autocomplete="username" required />
    </div>
    <div class="row">
      <label for="password">password</label>
      <input type="password" id="password" name="password" autocomplete="current-password" required />
    </div>
    <div class="actions">
      <button type="submit">log in</button>
    </div>
  </form>
  <p class="small" id="status" hidden></p>
  <p class="small" id="state"></p>

  <script>
    import { ApiError, login } from '../lib/api';
    import type { TokenPair } from '../lib/api';

    const TOKEN_KEY = 'sweg-ai-tokens';

    // Element lookups are typed here; the markup above owns these ids.
    function byId<T extends HTMLElement>(id: string): T {
      return document.getElementById(id) as T;
    }

    const form = byId<HTMLFormElement>('login-form');
    const status = byId<HTMLParagraphElement>('status');
    const state = byId<HTMLParagraphElement>('state');

    function tokens(): TokenPair | null {
      try {
        return JSON.parse(localStorage.getItem(TOKEN_KEY) ?? 'null');
      } catch {
        return null;
      }
    }

    function renderState() {
      const pair = tokens();
      state.textContent = pair?.access_token ? 'token stored in this browser. ' : 'not logged in.';
      if (!pair?.access_token) return;
      const out = document.createElement('button');
      out.type = 'button';
      out.className = 'linkbutton';
      out.textContent = 'log out';
      out.addEventListener('click', () => {
        localStorage.removeItem(TOKEN_KEY);
        status.hidden = true;
        renderState();
      });
      state.append(out);
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      status.className = 'small';
      status.textContent = 'logging in…';
      status.hidden = false;
      try {
        // TokenPair { access_token, token_type, expires_in, refresh_token, refresh_expires_in }
        const pair = await login(
          byId<HTMLInputElement>('identifier').value,
          byId<HTMLInputElement>('password').value,
        );
        localStorage.setItem(TOKEN_KEY, JSON.stringify(pair));
        form.reset();
        status.className = 'small ok';
        status.textContent = `logged in — access token good for ${Math.round(pair.expires_in / 60)} minutes.`;
        renderState();
      } catch (error) {
        status.className = 'small err';
        // ApiError carries the API's text/plain reason; anything else means the request
        // never landed (offline, or the API's CORS policy blocking this origin).
        status.textContent = error instanceof ApiError ? error.message : 'could not reach the API from this page.';
      }
    });

    renderState();
  </script>
</Base>
