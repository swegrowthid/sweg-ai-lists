---
import Base from '../layouts/Base.astro';
---
<Base title="login">
  <div class="auth">
    <p class="eyebrow">welcome back</p>
    <h1>Log in</h1>
    <p>The token stays in this browser and is what <a href="/submit">submit</a> posts with.</p>
    <div class="box">
      <form class="form" id="login-form">
        <div class="row">
          <label for="identifier">username or email</label>
          <input type="text" id="identifier" name="identifier" autocomplete="username" required />
        </div>
        <div class="row">
          <label for="password">password</label>
          <input type="password" id="password" name="password" autocomplete="current-password" required />
        </div>
        <div class="actions">
          <button type="submit">log in</button>
        </div>
        <p class="small" id="status" hidden></p>
      </form>
      <form class="form" id="magic-form" hidden>
        <div class="row">
          <label for="magic-email">email</label>
          <input type="email" id="magic-email" name="email" autocomplete="email" required />
        </div>
        <div class="actions">
          <button type="submit">email me a sign-in link</button>
        </div>
        <p class="small" id="magic-status" hidden></p>
      </form>
      <p class="alt">
        <button type="button" class="category-toggle" id="swap-magic">email me a sign-in link instead</button>
        <button type="button" class="category-toggle" id="swap-password" hidden>log in with a password instead</button>
      </p>
    </div>
    <p class="alt">Don't have an account? <a href="/register">sign up</a></p>
    <p class="alt muted" id="state"></p>
    <p class="small" id="changed" hidden></p>
    <p class="small" id="expired" hidden></p>
  </div>

  <script>
    import { ApiError, login, requestMagicLink } from '../lib/api';
    import type { TokenPair } from '../lib/api';
    import { goInternal } from '../lib/nav';
    import { logoutSession } from '../lib/session';

    const TOKEN_KEY = 'sweg-ai-tokens';

    // Element lookups are typed here; the markup above owns these ids.
    function byId<T extends HTMLElement>(id: string): T {
      return document.getElementById(id) as T;
    }

    const form = byId<HTMLFormElement>('login-form');
    const status = byId<HTMLParagraphElement>('status');
    const state = byId<HTMLParagraphElement>('state');

    function tokens(): TokenPair | null {
      try {
        return JSON.parse(localStorage.getItem(TOKEN_KEY) ?? 'null');
      } catch {
        return null;
      }
    }

    const params = new URLSearchParams(location.search);

    // Only same-origin return paths: a crafted ?next= must not send the
    // freshly logged-in user off-site.
    function nextPath(): string {
      const raw = params.get('next');
      if (!raw) return '/';
      try {
        const url = new URL(raw, location.origin);
        return url.origin === location.origin ? `${url.pathname}${url.search}` : '/';
      } catch {
        return '/';
      }
    }

    function renderState() {
      const pair = tokens();
      state.textContent = pair?.access_token ? 'token stored in this browser. ' : 'not logged in.';
      if (!pair?.access_token) return;
      const out = document.createElement('button');
      out.type = 'button';
      out.className = 'linkbutton';
      out.textContent = 'log out';
      out.addEventListener('click', () => {
        logoutSession();
        goInternal('/');
      });
      state.append(out);
      state.append(' · ');
      const view = document.createElement('a');
      view.href = '/profile';
      view.textContent = 'view profile';
      state.append(view);
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      status.className = 'small';
      status.textContent = 'logging in…';
      status.hidden = false;
      try {
        // TokenPair { access_token, token_type, expires_in, refresh_token, refresh_expires_in }
        const pair = await login(
          byId<HTMLInputElement>('identifier').value,
          byId<HTMLInputElement>('password').value,
        );
        localStorage.setItem(TOKEN_KEY, JSON.stringify(pair));
        goInternal(nextPath());
      } catch (error) {
        status.className = 'small err';
        // ApiError carries the API's text/plain reason; anything else means the request
        // never landed (offline, or the API's CORS policy blocking this origin).
        status.textContent =
          error instanceof ApiError ? error.message : 'could not reach the API from this page.';
        // 401 covers a wrong password AND an unknown account - point to register.
        if (error instanceof ApiError && error.status === 401) {
          status.append(' ');
          const link = document.createElement('a');
          link.href = '/register';
          link.textContent = 'no account? sign up';
          status.append(link);
        }
      }
    });

    const magicForm = byId<HTMLFormElement>('magic-form');
    const magicStatus = byId<HTMLParagraphElement>('magic-status');

    // One sign-in method is visible at a time; the swap link reveals the other
    // one, so the page never shows two competing forms for the user to pick.
    const swapToMagic = byId<HTMLButtonElement>('swap-magic');
    const swapToPassword = byId<HTMLButtonElement>('swap-password');

    function showMagic(show: boolean) {
      form.hidden = show;
      magicForm.hidden = !show;
      swapToMagic.hidden = show;
      swapToPassword.hidden = !show;
      status.hidden = true;
      magicStatus.hidden = true;
      if (show) byId<HTMLInputElement>('magic-email').focus();
      else byId<HTMLInputElement>('identifier').focus();
    }

    swapToMagic.addEventListener('click', () => showMagic(true));
    swapToPassword.addEventListener('click', () => showMagic(false));

    magicForm.addEventListener('submit', async (event) => {
      event.preventDefault();
      const button = magicForm.querySelector('button') as HTMLButtonElement;
      button.disabled = true;
      magicStatus.className = 'small';
      magicStatus.textContent = 'sending…';
      magicStatus.hidden = false;
      try {
        // The API answers the same generic message for registered and
        // unregistered email, so this line never reveals which one it was.
        magicStatus.textContent = await requestMagicLink(
          byId<HTMLInputElement>('magic-email').value.trim(),
        );
      } catch (error) {
        magicStatus.className = 'small err';
        if (error instanceof ApiError && error.status === 429) {
          magicStatus.textContent = 'too many requests - try again later.';
        } else if (error instanceof ApiError && error.status === 400) {
          magicStatus.textContent = 'enter a valid email address.';
        } else {
          magicStatus.textContent = 'could not reach the API from this page.';
        }
      } finally {
        button.disabled = false;
      }
    });

    // Fixed strings only: query values are never rendered, so ?changed=1 and
    // ?expired=1 cannot inject markup here.
    if (params.get('changed') === '1') {
      const changed = byId<HTMLParagraphElement>('changed');
      changed.textContent = 'password changed - log in with your new password.';
      changed.hidden = false;
    }
    if (params.get('expired') === '1') {
      const expired = byId<HTMLParagraphElement>('expired');
      expired.textContent = 'your session expired - log in again to continue.';
      expired.hidden = false;
    }

    renderState();
  </script>
</Base>
