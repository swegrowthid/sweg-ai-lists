---
import Base from '../layouts/Base.astro';
import EntryRows from '../components/EntryRows.astro';
import { fetchCategories, fetchPosts, postToRow } from '../lib/api';
import type { ApiCategory, ApiPost } from '../lib/api';

// Build-time snapshot: the client script below refreshes the same sections
// from the live API, so new posts appear without a rebuild.
let apiPosts: ApiPost[] = [];
try {
  apiPosts = await fetchPosts();
} catch {
  apiPosts = [];
}

let cats: ApiCategory[] = [];
try {
  cats = await fetchCategories();
} catch {
  cats = [];
}

// Posts grouped by first category slug, newest first on created_at.
const sections = cats.map((cat) => ({
  cat,
  rows: apiPosts
    .filter((post) => (post.categories[0]?.slug ?? 'uncategorized') === cat.slug)
    .map((post) => ({ ts: Date.parse(post.created_at) || 0, row: postToRow(post) }))
    .sort((a, b) => b.ts - a.ts)
    .map((item) => item.row),
}));
---

<Base>
  <div id="front">
    <div class="col">
      <form class="search" action="/search" method="get">
        <input type="text" name="q" />
        <button type="submit">&gt;</button>
      </form>
      <div class="box lists">
        <ul id="cat-list">
          {cats.map((c) => (
            <li data-slug={c.slug}><a href={`/s/${c.slug}`}>{c.name}</a></li>
          ))}
          <li data-static><a href="/wanted">wanted</a></li>
          <li data-static><a href="/submit" data-auth="in" hidden>submit</a></li>
          <li data-static><a href="/help">help</a></li>
        </ul>
      </div>
    </div>
    <div class="col" style="flex:1" id="home-groups">
      {sections.map((s) => (
        <section data-cat={s.cat.slug}>
          <h3><a href={`/s/${s.cat.slug}`}>{s.cat.name}</a></h3>
          {s.rows.length > 0 ? <EntryRows rows={s.rows} /> : <p class="muted">No entries yet in this category.</p>}
        </section>
      ))}
      {sections.length === 0 && <p class="muted">No entries yet.</p>}
    </div>
  </div>

  <script>
    import { fetchCategories, fetchPosts, postToRow } from '../lib/api';
    import { CATEGORY_NAME } from '../data/site';

    function esc(value: string): string {
      return value.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c] ?? c);
    }

    function rowHtml(row: ReturnType<typeof postToRow>): string {
      const summary =
        row.summary && row.summary !== row.title ? `<span class="muted"> - ${esc(row.summary)}</span>` : '';
      const attrs = Object.entries(row.attrs ?? {})
        .map(([k, v]) => ` ${k}="${esc(v)}"`)
        .join('');
      return (
        `<tr${attrs}><td class="d">${esc(row.date)}</td>` +
        `<td><a href="${esc(row.url)}">${esc(row.title)}</a>${summary}</td>` +
        `<td class="c"><a href="/s/${esc(row.category)}">${esc(CATEGORY_NAME[row.category] ?? row.category)}</a></td>` +
        `<td class="c">${esc(row.author)}</td>` +
        `<td class="p"><span class="price">${esc(row.display)}</span></td></tr>`
      );
    }

    // Live refresh: same grouping as the build-time snapshot above, rebuilt
    // from GET /categories + GET /posts. No new backend route; the existing
    // list endpoint already returns every post with its categories.
    async function refreshHome() {
      let cats;
      let posts;
      try {
        [cats, posts] = await Promise.all([fetchCategories(), fetchPosts()]);
      } catch {
        return; // keep the build-time snapshot
      }
      const list = document.getElementById('cat-list');
      if (list) {
        list.querySelectorAll('li[data-slug]').forEach((el) => el.remove());
        const anchor = list.querySelector('li[data-static]');
        for (const cat of cats) {
          const li = document.createElement('li');
          li.setAttribute('data-slug', cat.slug);
          const a = document.createElement('a');
          a.href = `/s/${cat.slug}`;
          a.textContent = cat.name;
          li.appendChild(a);
          if (anchor) list.insertBefore(li, anchor);
          else list.appendChild(li);
        }
      }
      const groups = document.getElementById('home-groups');
      if (!groups) return;
      const byCat = new Map<string, { ts: number; row: ReturnType<typeof postToRow> }[]>();
      for (const post of posts) {
        const slug = post.categories[0]?.slug ?? 'uncategorized';
        const bucket = byCat.get(slug);
        const entry = { ts: Date.parse(post.created_at) || 0, row: postToRow(post) };
        if (bucket) bucket.push(entry);
        else byCat.set(slug, [entry]);
      }
      const slugs = [
        ...cats.map((c) => c.slug),
        ...[...byCat.keys()].filter((s) => !cats.some((c) => c.slug === s)),
      ];
      if (slugs.length === 0) {
        groups.innerHTML = `<p class="muted">No entries yet.</p>`;
        return;
      }
      groups.innerHTML = slugs
        .map((slug) => {
          const cat = cats.find((c) => c.slug === slug);
          const name = cat ? cat.name : (CATEGORY_NAME[slug] ?? slug);
          const rows = (byCat.get(slug) ?? [])
            .sort((a, b) => b.ts - a.ts)
            .map((item) => item.row);
          const body =
            rows.length > 0
              ? `<table class="rows"><tbody>${rows.map(rowHtml).join('')}</tbody></table>`
              : `<p class="muted">No entries yet in this category.</p>`;
          return `<section data-cat="${esc(slug)}"><h3><a href="/s/${esc(slug)}">${esc(name)}</a></h3>${body}</section>`;
        })
        .join('');
    }

    void refreshHome();
  </script>
</Base>
