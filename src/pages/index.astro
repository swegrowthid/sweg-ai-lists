---
import Base from '../layouts/Base.astro';
import EntryRows from '../components/EntryRows.astro';
import { fetchCategories, fetchPosts, postToRow } from '../lib/api';
import type { ApiCategory, ApiPost } from '../lib/api';

// Home is pure API: no local entries, no static categories. Empty backend
// renders empty sections; content appears when the API has data.
let apiPosts: ApiPost[] = [];
try {
  apiPosts = await fetchPosts();
} catch {
  apiPosts = [];
}

let cats: ApiCategory[] = [];
try {
  cats = await fetchCategories();
} catch {
  cats = [];
}
// API rows only, newest first on created_at (the field postToRow renders).
const rows = apiPosts
  .map((post) => ({ ts: Date.parse(post.created_at) || 0, row: postToRow(post) }))
  .sort((a, b) => b.ts - a.ts)
  .map((item) => item.row);

// Flat API list: the Category schema has no skills/settings discriminator,
// so no grouping. Empty API renders no category links.
---

<Base>
  <div id="front">
    <div class="col">
      <form class="search" action="/search" method="get">
        <input type="text" name="q" />
        <button type="submit">&gt;</button>
      </form>
      <div class="box lists">
        <ul>
          {cats.map((c) => (
            <li><a href={`/s/${c.slug}`}>{c.name}</a></li>
          ))}
          <li><a href="/wanted">wanted</a></li>
          <li><a href="/submit" data-auth="in" hidden>submit</a></li>
          <li><a href="/help">help</a></li>
        </ul>
      </div>
    </div>
    <div class="col" style="flex:1">
      <h3>newest</h3>
      {rows.length > 0 ? <EntryRows rows={rows} /> : <p class="muted">No entries yet.</p>}
    </div>
  </div>
</Base>
