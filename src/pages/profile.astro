---
import Base from '../layouts/Base.astro';
---
<Base title="profile" crumb="profile">
  <header class="page-head">
    <p class="eyebrow">your account</p>
    <h1>Profile</h1>
  </header>

  <p class="muted" id="checking">checking your account…</p>

  <p id="guest" hidden>
    You are not logged in. <a href="/login">log in</a> or <a href="/register">register</a>.
  </p>

  <div class="box" id="card" hidden>
    <div class="who">
      <span class="avatar" id="avatar-initial" aria-hidden="true">?</span>
      <div>
        <strong id="uname"></strong>
        <p class="small muted">logged in on this browser</p>
      </div>
    </div>
    <table>
      <tr><th>username</th><td id="f-username"></td></tr>
      <tr><th>email</th><td id="f-email">loading…</td></tr>
      <tr><th>member since</th><td id="f-since">loading…</td></tr>
    </table>
    <p class="small err" id="details-note" hidden></p>
    <p class="small">
      <button type="button" class="linkbutton" id="logout">log out</button>
      · <a href="/change-password">change password</a>
      · <a href="/submit">post an entry</a>
    </p>
  </div>

  <script>
    import { ApiError, fetchUsers } from '../lib/api';
    import { claims, ensurePair, handleExpiredSession, isTokenExpired, logoutSession, storedPair } from '../lib/session';
    import type { EnsuredPair } from '../lib/session';

    // Element lookups are typed here; the markup above owns these ids.
    function byId<T extends HTMLElement>(id: string): T {
      return document.getElementById(id) as T;
    }

    async function main() {
      const hadTokens = !!storedPair();
      let pair: EnsuredPair;
      try {
        pair = await ensurePair();
      } catch {
        // The session may be fine; the API just did not answer. Keep it and
        // say so instead of logging out or redirecting.
        const checking = byId<HTMLParagraphElement>('checking');
        checking.textContent = 'could not reach the API - reload to try again.';
        checking.className = 'small err';
        return;
      }
      const c = pair ? claims(pair.access_token) : null;
      byId<HTMLParagraphElement>('checking').hidden = true;
      if (!pair || !c?.sub) {
        // Tokens existed but died (refresh rejected) -> must log in again.
        if (hadTokens) {
          handleExpiredSession();
          return;
        }
        byId<HTMLParagraphElement>('guest').hidden = false;
        return;
      }

      const card = byId<HTMLDivElement>('card');
      card.hidden = false;
      // The JWT already proves identity - paint it before any fetch lands.
      const username = c.username ?? '';
      byId('avatar-initial').textContent = Array.from(username.trim().replace(/^@+/, ''))[0]?.toUpperCase() ?? '?';
      byId('uname').textContent = username;
      byId('f-username').textContent = username;

      byId<HTMLButtonElement>('logout').addEventListener('click', () => {
        logoutSession();
        location.href = '/';
      });

      try {
        // No GET /users/{id} on the API - find self by the token's `sub`.
        const me = (await fetchUsers(pair.access_token)).find((u) => u.id === c.sub);
        if (!me) throw new ApiError(0, 'account not found in the user list');
        byId('f-email').textContent = me.email;
        const since = new Date(me.created_at);
        byId('f-since').textContent = Number.isNaN(+since)
          ? me.created_at
          : since.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
      } catch (error) {
        // A dead token must log in again; the redirect clears the pair.
        if (isTokenExpired(error)) {
          handleExpiredSession();
          return;
        }
        // Partial: the card still proves login; only the server fields are missing.
        byId('f-email').textContent = '—';
        byId('f-since').textContent = '—';
        const note = byId<HTMLParagraphElement>('details-note');
        note.textContent = 'could not load account details from the API - showing what the token holds.';
        note.hidden = false;
      }
    }

    void main();
  </script>
</Base>
