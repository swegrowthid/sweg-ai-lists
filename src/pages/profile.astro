---
import Base from '../layouts/Base.astro';
---
<Base title="Profile">
  <header class="page-head">
    <p class="eyebrow">your account</p>
    <h1>Profile</h1>
  </header>

  <p class="muted" id="checking">checking your account…</p>

  <p id="guest" hidden>
    You are not logged in. <a href="/login">log in</a> or <a href="/register">register</a>.
  </p>

  <div class="box" id="card" hidden>
    <div class="who">
      <span class="avatar" id="avatar-initial" aria-hidden="true">?</span>
      <div>
        <strong id="uname"></strong>
        <p class="small muted">logged in on this browser</p>
      </div>
    </div>
    <table>
      <tr><th>username</th><td id="f-username"></td></tr>
      <tr><th>email</th><td id="f-email">loading…</td></tr>
      <tr><th>member since</th><td id="f-since">loading…</td></tr>
    </table>
    <p class="small err" id="details-note" hidden></p>
    <div id="links-box">
      <p class="small muted">linked accounts</p>
      <ul id="providers-list"></ul>
      <p class="small" id="providers-note" hidden></p>
      <p class="small" id="unlink-status" hidden></p>
    </div>
    <p class="small">
      <button type="button" class="linkbutton" id="logout">log out</button>
      · <a href="/change-password">change password</a>
      · <a href="/submit">post an entry</a>
    </p>
  </div>

  <script>
    import { ApiError, fetchCurrentProfile, unlinkIdentity } from '../lib/api';
    import { goInternal } from '../lib/nav';
    import { claims, ensurePair, handleExpiredSession, isTokenExpired, logoutSession, storedPair } from '../lib/session';
    import type { EnsuredPair } from '../lib/session';

    // Element lookups are typed here; the markup above owns these ids.
    function byId<T extends HTMLElement>(id: string): T {
      return document.getElementById(id) as T;
    }

    function setUnlinkStatus(text: string, cls: string) {
      const el = byId<HTMLParagraphElement>('unlink-status');
      el.className = cls;
      el.textContent = text;
      el.hidden = false;
    }

    function renderProviders(providers: string[], onUnlink: (provider: string, btn: HTMLButtonElement) => void) {
      const list = byId<HTMLUListElement>('providers-list');
      const note = byId<HTMLParagraphElement>('providers-note');
      list.innerHTML = '';
      if (providers.length === 0) {
        note.textContent = 'local-only account: no linked login. Password login is enabled.';
        note.className = 'small muted';
        note.hidden = false;
        return;
      }
      note.textContent = 'One link must stay: the last sign-in method cannot be removed.';
      note.className = 'small muted';
      note.hidden = false;
      for (const provider of providers) {
        const item = document.createElement('li');
        item.textContent = `${provider} `;
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'linkbutton';
        btn.dataset.provider = provider;
        btn.textContent = 'unlink';
        btn.addEventListener('click', () => onUnlink(provider, btn));
        item.appendChild(btn);
        list.appendChild(item);
      }
    }

    async function main() {
      const hadTokens = !!storedPair();
      let pair: EnsuredPair;
      try {
        pair = await ensurePair();
      } catch {
        // The session may be fine; the API just did not answer. Keep it and
        // say so instead of logging out or redirecting.
        const checking = byId<HTMLParagraphElement>('checking');
        checking.textContent = 'could not reach the API - reload to try again.';
        checking.className = 'small err';
        return;
      }
      const c = pair ? claims(pair.access_token) : null;
      byId<HTMLParagraphElement>('checking').hidden = true;
      if (!pair || !c?.sub) {
        // Tokens existed but died (refresh rejected) -> must log in again.
        if (hadTokens) {
          handleExpiredSession();
          return;
        }
        byId<HTMLParagraphElement>('guest').hidden = false;
        return;
      }

      const card = byId<HTMLDivElement>('card');
      card.hidden = false;
      // The JWT already proves identity - paint it before any fetch lands.
      const username = c.username ?? '';
      byId('avatar-initial').textContent = Array.from(username.trim().replace(/^@+/, ''))[0]?.toUpperCase() ?? '?';
      byId('uname').textContent = username;
      byId('f-username').textContent = username;

      byId<HTMLButtonElement>('logout').addEventListener('click', () => {
        logoutSession();
        goInternal('/');
      });

      async function onUnlink(provider: string, btn: HTMLButtonElement) {
        btn.disabled = true;
        setUnlinkStatus(`removing ${provider}…`, 'small');
        try {
          const fresh = await ensurePair();
          if (!fresh?.access_token) {
            handleExpiredSession();
            return;
          }
          await unlinkIdentity(provider, fresh.access_token);
          setUnlinkStatus(`${provider} removed.`, 'small');
          const freshProfile = await fetchCurrentProfile(fresh.access_token);
          renderProviders(freshProfile.providers, onUnlink);
        } catch (error) {
          btn.disabled = false;
          if (isTokenExpired(error)) {
            handleExpiredSession();
            return;
          }
          if (error instanceof ApiError && error.status === 404) {
            setUnlinkStatus('identity not linked.', 'small err');
            return;
          }
          if (error instanceof ApiError && error.status === 409) {
            setUnlinkStatus('cannot unlink the last sign-in method.', 'small err');
            return;
          }
          setUnlinkStatus(
            error instanceof ApiError ? error.message : 'could not reach the API from this page.',
            'small err',
          );
        }
      }

      try {
        // Single source: GET /users/me carries id, email, dates, providers.
        const me = await fetchCurrentProfile(pair.access_token);
        byId('f-email').textContent = me.email;
        const since = new Date(me.created_at);
        byId('f-since').textContent = Number.isNaN(+since)
          ? me.created_at
          : since.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
        renderProviders(me.providers, onUnlink);
      } catch (error) {
        // A dead token must log in again; the redirect clears the pair.
        if (isTokenExpired(error)) {
          handleExpiredSession();
          return;
        }
        // Partial: the card still proves login; only the server fields are missing.
        byId('f-email').textContent = '-';
        byId('f-since').textContent = '-';
        const note = byId<HTMLParagraphElement>('details-note');
        note.textContent = 'could not load account details from the API - showing what the token holds.';
        note.hidden = false;
      }
    }

    void main();
  </script>
</Base>
