---
import Base from '../layouts/Base.astro';
---
<Base title="Change password">
  <header class="page-head">
    <p class="eyebrow">your account</p>
    <h1>Change password</h1>
  </header>

  <p class="muted" id="checking">checking your account…</p>

  <p id="guest" hidden>
    You are not logged in. <a href="/login">log in</a> or <a href="/register">register</a>.
  </p>

  <div class="box" id="card" hidden>
    <p class="muted">Changing your password signs you out of every device. You will log in again with the new password.</p>
    <p class="small" id="oauth-note" hidden>
      This account uses external login. Set a password once to enable email login too.
    </p>
    <form class="form" id="change-form">
      <div class="row" id="current-row">
        <label for="current-password">current password</label>
        <input type="password" id="current-password" name="current-password" autocomplete="current-password" />
      </div>
      <div class="row">
        <label for="new-password">new password</label>
        <input type="password" id="new-password" name="new-password" autocomplete="new-password" maxlength="72" required />
        <p class="small">up to 72 characters.</p>
      </div>
      <div class="row">
        <label for="confirm-password">confirm new password</label>
        <input type="password" id="confirm-password" name="confirm-password" autocomplete="new-password" maxlength="72" required />
      </div>
      <div class="actions">
        <button type="submit" id="submit-btn">change password</button>
      </div>
      <p class="small" id="status" hidden></p>
    </form>
    <p class="small" id="mode-row" hidden>
      <button type="button" class="linkbutton" id="mode-toggle"></button>
    </p>
  </div>

  <script>
    import { ApiError, fetchCurrentProfile, updatePassword } from '../lib/api';
    import { goInternal } from '../lib/nav';
    import { claims, clearPair, ensurePair, handleExpiredSession, isTokenExpired, storedPair } from '../lib/session';
    import type { EnsuredPair } from '../lib/session';

    // Element lookups are typed here; the markup above owns these ids.
    function byId<T extends HTMLElement>(id: string): T {
      return document.getElementById(id) as T;
    }

    const form = byId<HTMLFormElement>('change-form');
    const status = byId<HTMLParagraphElement>('status');
    const currentRow = byId<HTMLDivElement>('current-row');
    const oauthNote = byId<HTMLParagraphElement>('oauth-note');
    const modeRow = byId<HTMLParagraphElement>('mode-row');
    const modeToggle = byId<HTMLButtonElement>('mode-toggle');
    const submitBtn = byId<HTMLButtonElement>('submit-btn');

    // True means first-password mode: current field hidden, sent as "".
    let setFirst = false;

    function setStatus(text: string, cls: string) {
      status.className = cls;
      status.textContent = text;
      status.hidden = false;
    }

    function applyMode() {
      currentRow.hidden = setFirst;
      byId<HTMLInputElement>('current-password').required = !setFirst;
      submitBtn.textContent = setFirst ? 'set password' : 'change password';
      modeToggle.textContent = setFirst
        ? 'I already have a password'
        : 'set first password instead';
    }

    async function main() {
      const hadTokens = !!storedPair();
      let pair: EnsuredPair;
      try {
        pair = await ensurePair();
      } catch {
        // The session may be fine; the API just did not answer. Keep it and
        // say so instead of logging out or redirecting.
        const checking = byId<HTMLParagraphElement>('checking');
        checking.textContent = 'could not reach the API - reload to try again.';
        checking.className = 'small err';
        return;
      }
      const c = pair ? claims(pair.access_token) : null;
      byId<HTMLParagraphElement>('checking').hidden = true;
      if (!pair || !c?.sub) {
        // Tokens existed but died (refresh rejected) -> must log in again.
        if (hadTokens) {
          handleExpiredSession();
          return;
        }
        byId<HTMLParagraphElement>('guest').hidden = false;
        return;
      }
      byId<HTMLDivElement>('card').hidden = false;

      // Offer first-password mode when the account has linked login.
      try {
        const me = await fetchCurrentProfile(pair.access_token);
        if (me.providers.length > 0) {
          const params = new URLSearchParams(location.search);
          setFirst = params.get('mode') === 'set';
          oauthNote.hidden = false;
          modeRow.hidden = false;
          applyMode();
        } else {
          setFirst = false;
          applyMode();
        }
      } catch {
        setFirst = false;
        applyMode();
      }

      modeToggle.addEventListener('click', () => {
        setFirst = !setFirst;
        status.hidden = true;
        applyMode();
      });

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        const currentPassword = setFirst ? '' : byId<HTMLInputElement>('current-password').value;
        const newPassword = byId<HTMLInputElement>('new-password').value;
        const confirmPassword = byId<HTMLInputElement>('confirm-password').value;
        if (newPassword !== confirmPassword) {
          setStatus('new password and confirmation do not match.', 'small err');
          return;
        }
        if (!setFirst && newPassword === currentPassword) {
          setStatus('new password must be different from the current password.', 'small err');
          return;
        }
        setStatus(setFirst ? 'setting password…' : 'changing password…', 'small');
        try {
          // Re-gate here: the pair captured at page load may have expired
          // while the user typed. A throw means unreachable, handled below.
          const fresh = await ensurePair();
          if (!fresh?.access_token) {
            handleExpiredSession();
            return;
          }
          await updatePassword(currentPassword, newPassword, fresh.access_token);
          // The API revokes every refresh token on purpose. Clear the local
          // pair and make the user log in with the new password.
          clearPair();
          goInternal('/login?changed=1');
        } catch (error) {
          // A dead token must log in again; the redirect clears the pair.
          if (isTokenExpired(error)) {
            handleExpiredSession();
            return;
          }
          if (error instanceof ApiError && error.status === 401) {
            // Wrong current password, or first-password attempt while a
            // password already exists: session stays valid either way.
            if (setFirst) {
              setFirst = false;
              applyMode();
              setStatus('a password already exists - enter the current one.', 'small err');
              return;
            }
            setStatus(error.message, 'small err');
            return;
          }
          setStatus(
            error instanceof ApiError ? error.message : 'could not reach the API from this page.',
            'small err',
          );
        }
      });
    }

    void main();
  </script>
</Base>
