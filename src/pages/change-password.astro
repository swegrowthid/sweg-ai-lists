---
import Base from '../layouts/Base.astro';
---
<Base title="change password" crumb="change password">
  <header class="page-head">
    <p class="eyebrow">your account</p>
    <h1>Change password</h1>
  </header>

  <p class="muted" id="checking">checking your account…</p>

  <p id="guest" hidden>
    You are not logged in. <a href="/login">log in</a> or <a href="/register">register</a>.
  </p>

  <div class="box" id="card" hidden>
    <p class="muted">Changing your password signs you out of every device. You will log in again with the new password.</p>
    <form class="form" id="change-form">
      <div class="row">
        <label for="current-password">current password</label>
        <input type="password" id="current-password" name="current-password" autocomplete="current-password" required />
      </div>
      <div class="row">
        <label for="new-password">new password</label>
        <input type="password" id="new-password" name="new-password" autocomplete="new-password" maxlength="72" required />
        <p class="small">up to 72 characters.</p>
      </div>
      <div class="row">
        <label for="confirm-password">confirm new password</label>
        <input type="password" id="confirm-password" name="confirm-password" autocomplete="new-password" maxlength="72" required />
      </div>
      <div class="actions">
        <button type="submit">change password</button>
      </div>
      <p class="small" id="status" hidden></p>
    </form>
  </div>

  <script>
    import { ApiError, updatePassword } from '../lib/api';
    import { claims, clearPair, ensurePair, handleExpiredSession, isTokenExpired, storedPair } from '../lib/session';

    // Element lookups are typed here; the markup above owns these ids.
    function byId<T extends HTMLElement>(id: string): T {
      return document.getElementById(id) as T;
    }

    const form = byId<HTMLFormElement>('change-form');
    const status = byId<HTMLParagraphElement>('status');

    function setStatus(text: string, cls: string) {
      status.className = cls;
      status.textContent = text;
      status.hidden = false;
    }

    async function main() {
      const hadTokens = !!storedPair();
      const pair = await ensurePair();
      const c = pair ? claims(pair.access_token) : null;
      byId<HTMLParagraphElement>('checking').hidden = true;
      if (!pair || !c?.sub) {
        // Tokens existed but died (refresh rejected) -> must log in again.
        if (hadTokens) {
          handleExpiredSession();
          return;
        }
        byId<HTMLParagraphElement>('guest').hidden = false;
        return;
      }
      byId<HTMLDivElement>('card').hidden = false;

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        const currentPassword = byId<HTMLInputElement>('current-password').value;
        const newPassword = byId<HTMLInputElement>('new-password').value;
        const confirmPassword = byId<HTMLInputElement>('confirm-password').value;
        if (newPassword !== confirmPassword) {
          setStatus('new password and confirmation do not match.', 'small err');
          return;
        }
        if (newPassword === currentPassword) {
          setStatus('new password must be different from the current password.', 'small err');
          return;
        }
        setStatus('changing password…', 'small');
        try {
          await updatePassword(currentPassword, newPassword, pair.access_token);
          // The API revokes every refresh token on purpose. Clear the local
          // pair and make the user log in with the new password.
          clearPair();
          location.href = '/login?changed=1';
        } catch (error) {
          // A dead token must log in again; the redirect clears the pair.
          if (isTokenExpired(error)) {
            handleExpiredSession();
            return;
          }
          if (error instanceof ApiError && error.status === 401) {
            // Wrong current password: a credential answer, session stays valid.
            setStatus(error.message, 'small err');
            return;
          }
          setStatus(
            error instanceof ApiError ? error.message : 'could not reach the API from this page.',
            'small err',
          );
        }
      });
    }

    void main();
  </script>
</Base>
